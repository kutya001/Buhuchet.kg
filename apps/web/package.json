{
  "name": "@buhuchet/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node ../../scripts/build-demo.mjs --dev && node ../../scripts/build-techdocs.mjs && next dev",
    "build": "node ../../scripts/build-demo.mjs && node ../../scripts/build-techdocs.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@buhuchet/api": "workspace:*",
    "@buhuchet/domain": "workspace:*",
    "@buhuchet/shared": "workspace:*",
    "@buhuchet/ui": "workspace:*",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "^5.105.0",
    "hono": "catalog:",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.90.0"
  },
  "devDependencies": {
    "@buhuchet/adapters": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
