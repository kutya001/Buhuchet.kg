# Настройки окружения Buhuchet.kg. Локально: `cp .env.example .env` — значения подходят к docker-compose.yml.
# На стенде и рабочем сайте те же переменные задаются в настройках Vercel и GitHub Actions, в репозиторий не попадают.

# local | test | staging | production
APP_ENV=local
APP_VERSION=0.0.0-dev
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# База. DATABASE_URL — роль приложения (RLS действует), создаётся `pnpm db:migrate` с паролем из этой строки.
# DATABASE_ADMIN_URL — владелец схемы: только миграции и начальное наполнение.
DATABASE_URL=postgres://buhuchet_web:buhuchet_web@localhost:5432/buhuchet
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/buhuchet
DATABASE_POOL_MAX=5
# Пароль демо-сотрудников (erkin, meerim, alisher…) для `pnpm db:seed`; на рабочем сайте демо нет.
DEMO_PASSWORD=demo
# Администратор платформы для `pnpm db:seed` (создаётся, если его нет; пароль временный — сменить при
# первом входе; повторное наполнение пароль не меняет). Задаются вместе; локально обычно не нужны.
PLATFORM_ADMIN_LOGIN=
PLATFORM_ADMIN_PASSWORD=

# Файлы по протоколу S3 (локально — MinIO из docker-compose).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=buhuchet
S3_ACCESS_KEY_ID=buhuchet
S3_SECRET_ACCESS_KEY=buhuchet-secret
S3_FORCE_PATH_STYLE=true
# Адрес хранилища для браузера, если он другой, чем у сайта (docker-compose: сайт — http://minio:9000,
# браузер — http://localhost:9000; VPS — свой поддомен). По нему подписываются ссылки на файлы. Пусто — S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# Секрет, с которым планировщик вызывает /api/cron/tick (на Vercel — переменная CRON_SECRET).
CRON_SECRET=local-cron-secret-change-me

# Telegram-бот (необязательно; токен, секрет вебхука и имя бота без «@» задаются вместе).
# Секрет — от 16 символов: латиница, цифры, _ и -. Вебхук сайт регистрирует сам (только по https).
# Здесь — выдуманный бот для сквозных тестов: сообщения уходят не в Telegram, а подделке Bot API
# (e2e/fake-telegram.ts, её запускают сами тесты). На стенде и рабочем сайте — настоящий бот в настройках
# Vercel, секрет вебхука — своя строка от 32 символов, TELEGRAM_API_BASE не задаётся.
TELEGRAM_BOT_TOKEN=100000001:local-fake-bot-token-change-me-0000
TELEGRAM_WEBHOOK_SECRET=local-webhook-secret-change-me
TELEGRAM_BOT_USERNAME=buhuchet_local_bot
TELEGRAM_API_BASE=http://localhost:8091

# Ошибки в Sentry (необязательно).
SENTRY_DSN=

# Зафиксировать «сейчас» (демо-стенд, сквозные тесты), например 2026-10-18T03:00:00Z. На рабочем сайте запрещено.
FIXED_NOW=

# Порт отдельного сервера API на VPS.
API_PORT=3001
