# Настройки окружения Buhuchet.kg. Локально: `cp .env.example .env` — значения подходят к docker-compose.yml.
# На стенде и рабочем сайте те же переменные задаются в настройках Vercel и GitHub Actions, в репозиторий не попадают.

# local | test | staging | production
APP_ENV=local
APP_VERSION=0.0.0-dev
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# База. DATABASE_URL — роль приложения (RLS действует), создаётся `pnpm db:migrate` с паролем из этой строки.
# DATABASE_ADMIN_URL — владелец схемы: только миграции и начальное наполнение.
DATABASE_URL=postgres://buhuchet_web:buhuchet_web@localhost:5432/buhuchet
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/buhuchet
DATABASE_POOL_MAX=5
# Пароль демо-сотрудников (erkin, meerim, alisher…) для `pnpm db:seed`; на рабочем сайте демо нет.
DEMO_PASSWORD=demo

# Файлы по протоколу S3 (локально — MinIO из docker-compose).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=buhuchet
S3_ACCESS_KEY_ID=buhuchet
S3_SECRET_ACCESS_KEY=buhuchet-secret
S3_FORCE_PATH_STYLE=true

# Секрет, с которым планировщик вызывает /api/cron/tick (на Vercel — переменная CRON_SECRET).
CRON_SECRET=local-cron-secret-change-me

# Telegram-бот (необязательно; токен, секрет вебхука и имя бота без «@» задаются вместе).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Ошибки в Sentry (необязательно).
SENTRY_DSN=

# Зафиксировать «сейчас» (демо-стенд, сквозные тесты), например 2026-10-18T03:00:00Z. На рабочем сайте запрещено.
FIXED_NOW=

# Порт отдельного сервера API на VPS.
API_PORT=3001
