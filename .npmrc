# Строгой проверки версии Node.js (engine-strict) здесь нет намеренно: Dependabot обновляет пакеты
# на своей версии Node.js, с ней его обновления падали и PR не открывались (docs/decisions.md п. О-67,
# docs/typical-mistakes.md № 82). По той же причине нет engineStrict в pnpm-workspace.yaml.
# Строгая проверка — в сборке образов (Dockerfile); версию Node.js в CI задаёт .nvmrc,
# на Vercel — engines в apps/web/package.json.
auto-install-peers=true
