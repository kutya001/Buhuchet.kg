{
  "name": "@buhuchet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./web": "./src/web.ts",
    "./jobs": "./src/jobs/runner.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start:standalone": "node --env-file-if-exists=../../.env --import tsx src/standalone.ts"
  },
  "dependencies": {
    "@buhuchet/adapters": "workspace:*",
    "@buhuchet/db": "workspace:*",
    "@buhuchet/domain": "workspace:*",
    "@buhuchet/shared": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
