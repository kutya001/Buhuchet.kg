{
  "name": "@buhuchet/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./clock": "./src/clock.ts",
    "./storage": "./src/storage.ts",
    "./scheduler": "./src/scheduler.ts",
    "./telegram": "./src/telegram.ts",
    "./logger": "./src/logger.ts",
    "./password": "./src/password.ts",
    "./tokens": "./src/tokens.ts",
    "./documents": "./src/documents.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storage:init": "node --env-file-if-exists=../../.env --import tsx src/cli/storage-init.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@buhuchet/domain": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@tesseract.js-data/kir": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "pdfjs-dist": "6.4.299",
    "pino": "catalog:",
    "tesseract.js": "7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
